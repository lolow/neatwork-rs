// Panes of a project: the Java TopographiePane, DesignPane, SimulationPane,
// TextPane, and the welcome page (PresentationPanel).
import { TabWidget, Button, TextEdit, ComboBox, StandardListView, HorizontalBox, VerticalBox } from "std-widgets.slint";
import { AppState, T } from "state.slint";
import { DataTable, TableToolbar } from "table.slint";
import { TreeView, NetworkView } from "views.slint";
import { Nw5Workspace } from "nw5.slint";

export component WelcomePane inherits Rectangle {
    background: white;
    VerticalLayout {
        alignment: center;
        spacing: 20px;
        Text {
            text: "NeatWork";
            font-size: 40px;
            font-italic: true;
            horizontal-alignment: center;
        }
        Text {
            text: T.s("PresentationPanel.text");
            font-weight: 700;
            horizontal-alignment: center;
            wrap: word-wrap;
        }
    }
}

component TablesPane inherits VerticalBox {
    in property <bool> design;
    property <string> pfx: root.design ? "DesignTablePane." : "TopoTablePane.";
    TableToolbar {
        table-id: 0;
        title: T.s(root.pfx + "Node_list");
        insert-key: root.pfx + "Insert_a_new_node";
        delete-key: root.pfx + "Delete_selected_node(s)";
        can-copy: AppState.nodes-table.can-copy;
    }
    DataTable {
        table-id: 0;
        data: AppState.nodes-table;
        vertical-stretch: 1;
    }
    TableToolbar {
        table-id: 1;
        title: T.s(root.pfx + "Arc_list");
        insert-key: root.pfx + "Insert_a_new_pipe";
        delete-key: root.pfx + "Delete_selected_pipe(s)";
        can-copy: AppState.pipes-table.can-copy;
    }
    DataTable {
        table-id: 1;
        data: AppState.pipes-table;
        vertical-stretch: 1;
    }
    if root.design: Text {
        text: AppState.cost-text;
        font-weight: 700;
    }
}

component TextPane inherits VerticalBox {
    editor := TextEdit {
        text: AppState.text-content;
        font-family: "monospace";
        vertical-stretch: 1;
    }
    HorizontalLayout {
        spacing: 6px;
        Rectangle { horizontal-stretch: 1; }
        Button {
            text: T.s("TextPane.Undo");
            clicked => {
                AppState.text-undo();
                editor.text = AppState.text-content;
            }
        }
        Button {
            text: T.s("TextPane.Apply");
            primary: true;
            clicked => { AppState.text-apply(editor.text); }
        }
    }
}

component SimulationPane inherits HorizontalBox {
    VerticalLayout {
        width: 290px;
        spacing: 6px;
        HorizontalLayout {
            spacing: 4px;
            Button {
                text: T.s("SimulationPane.New_Simulation...");
                clicked => { AppState.menu("sim-new"); }
            }
            Button {
                text: T.s("SimulationPane.Delete_this_simulation");
                enabled: AppState.sim-current >= 0;
                clicked => { AppState.menu("sim-delete"); }
            }
        }
        HorizontalLayout {
            spacing: 4px;
            ComboBox {
                model: AppState.sim-list;
                current-index <=> AppState.sim-current;
                selected => { AppState.sim-select(self.current-index); }
            }
            Button {
                text: T.s("SimulationPane.report_in_HTML");
                enabled: AppState.sim-current >= 0;
                clicked => { AppState.menu("sim-report"); }
            }
        }
        Rectangle {
            border-width: 1px;
            border-color: #999;
            background: white;
            height: 120px;
            Text {
                x: 6px;
                y: 6px;
                width: parent.width - 12px;
                text: AppState.sim-params-text;
                wrap: word-wrap;
            }
        }
        StandardListView {
            model: [
                { text: T.s("SimulationPane.Flows_at_faucets") },
                { text: T.s("SimulationPane.Percentiles_at_faucets") },
                { text: T.s("SimulationPane.Speed_in_pipes") },
                { text: T.s("SimulationPane.Nodes_pressure") },
            ];
            current-item: AppState.sim-table-kind - 1;
            current-item-changed(i) => { AppState.sim-table-select(i + 1); }
        }
    }
    if AppState.sim-current >= 0: DataTable {
        table-id: 40;
        data: AppState.sim-table;
        horizontal-stretch: 1;
    }
    if AppState.sim-current < 0: Rectangle { horizontal-stretch: 1; }
}

export component ProjectPane inherits Rectangle {
    if AppState.current-kind == 0: TabWidget {
        current-index <=> AppState.pane-tab;
        Tab {
            title: T.s("TopographiePane.Tables");
            TablesPane { design: false; }
        }
        Tab {
            title: T.s("TopographiePane.Tree_View");
            TreeView { }
        }
        Tab {
            title: T.s("Gui.Network");
            NetworkView { }
        }
        Tab {
            title: T.s("TopographiePane.Text");
            TextPane { }
        }
    }
    if AppState.current-kind == 1: TabWidget {
        current-index <=> AppState.pane-tab;
        Tab {
            title: T.s("DesignPane.Tables");
            TablesPane { design: true; }
        }
        Tab {
            title: T.s("DesignPane.Simulation");
            SimulationPane { }
        }
        Tab {
            title: T.s("DesignPane.TreeView");
            TreeView { }
        }
        Tab {
            title: T.s("Gui.Network");
            NetworkView { }
        }
        Tab {
            title: T.s("DesignPane.Text");
            TextPane { }
        }
    }
    if AppState.current-kind == 2: Nw5Workspace { }
    if AppState.current-kind < 0: WelcomePane { }
}
